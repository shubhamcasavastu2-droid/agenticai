{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Agentic CLI",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "src.cli",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/backend/.env",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Debug CLI with custom args",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "src.cli",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/backend/.env",
      "args": ["--help"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Debug Tests",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "pytest",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/backend/.env",
      "args": ["tests/", "-v", "-s"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Debug Single Test",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "module": "pytest",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/backend/.env",
      "args": ["tests/test_tools.py::TestEditFile::test_edit_file_success", "-v", "-s"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    }
  ]
}