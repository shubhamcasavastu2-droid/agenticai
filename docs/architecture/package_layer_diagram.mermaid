```mermaid
graph TB
    %% Package/Layer Architecture Diagram
    
    subgraph "CLI Layer"
        CLI[cli.py]
    end
    
    subgraph "Core Agent Layer"
        AgentLoop[agent.py]
        AgentState[agent.py]
        CompletionResolver[completion.py]
        CompletionResult[completion.py]
    end
    
    subgraph "Provider Layer"
        Provider[provider.py]
        OpenAICompatibleProvider[provider.py]
        AnthropicProvider[provider.py]
        GeminiProvider[provider.py]
        ProviderTimeoutError[provider.py]
        ProviderAuthenticationError[provider.py]
    end
    
    subgraph "Types Layer"
        Types[types.py]
        Role[types.py]
        StopReason[types.py]
        TextBlock[types.py]
        ToolCall[types.py]
        ToolResult[types.py]
        ReasoningBlock[types.py]
        Message[types.py]
        ToolSchema[types.py]
        ModelResponse[types.py]
        Tool[types.py]
    end
    
    subgraph "Tools Layer"
        ToolRegistry[tools/registry.py]
        ReadFileTool[tools/read_file.py]
        WriteFileTool[tools/write_file.py]
        EditFileTool[tools/edit_file.py]
        GlobTool[tools/glob_tool.py]
        GrepTool[tools/grep_tool.py]
        BashTool[tools/bash_tool.py]
        AskUserTool[tools/ask_tool.py]
        PlanTool[tools/plan_tool.py]
        ToolSchemaFactory[tools/registry.py]
    end
    
    subgraph "Permissions Layer"
        PermissionGate[permissions.py]
        PathValidation[permissions.py]
        DenyList[permissions.py]
        Truncation[permissions.py]
    end
    
    subgraph "Configuration Layer"
        Config[config.py]
    end
    
    subgraph "Skills & Agents Layer"
        Skill[skills.py]
        SkillLoader[skills.py]
        Agent[agents.py]
        AgentLoader[agents.py]
    end
    
    subgraph "System Prompt Layer"
        SystemPrompt[system_prompt.py]
    end
    
    subgraph "Logging Layer"
        Logger[logger.py]
    end
    
    %% Dependencies
    
    %% CLI depends on everything
    CLI --> AgentLoop
    CLI --> CompletionResolver
    CLI --> Config
    CLI --> ToolRegistry
    CLI --> PermissionGate
    CLI --> SkillLoader
    CLI --> AgentLoader
    CLI --> SystemPrompt
    CLI --> Logger
    CLI --> OpenAICompatibleProvider
    
    %% Agent Loop depends on
    AgentLoop --> Provider
    AgentLoop --> ToolRegistry
    AgentLoop --> PermissionGate
    AgentLoop --> Types
    AgentLoop --> AgentState
    AgentLoop --> Logger
    
    %% Completion Resolver depends on
    CompletionResolver --> Provider
    CompletionResolver --> AgentLoop
    CompletionResolver --> Types
    CompletionResolver --> Logger
    
    %% Provider Layer
    Provider <|-- OpenAICompatibleProvider
    Provider <|-- AnthropicProvider
    Provider <|-- GeminiProvider
    OpenAICompatibleProvider --> Types
    OpenAICompatibleProvider --> httpx
    
    %% Tools Layer
    ToolRegistry --> Tool
    ToolRegistry --> ToolSchema
    Tool <|-- ReadFileTool
    Tool <|-- WriteFileTool
    Tool <|-- EditFileTool
    Tool <|-- GlobTool
    Tool <|-- GrepTool
    Tool <|-- BashTool
    Tool <|-- AskUserTool
    Tool <|-- PlanTool
    
    ReadFileTool --> PathValidation
    ReadFileTool --> Truncation
    WriteFileTool --> PathValidation
    EditFileTool --> PathValidation
    GlobTool --> Truncation
    GrepTool --> PathValidation
    GrepTool --> Truncation
    BashTool --> PathValidation
    BashTool --> Truncation
    BashTool --> DenyList
    AskUserTool --> Types
    PlanTool --> Types
    
    %% Permissions Layer
    PermissionGate --> DenyList
    PermissionGate --> Truncation
    
    %% Skills & Agents
    SkillLoader --> Skill
    SkillLoader --> yaml
    AgentLoader --> Agent
    AgentLoader --> yaml
    
    %% System Prompt
    SystemPrompt --> Config
    SystemPrompt --> Types
    SystemPrompt --> ToolRegistry
    SystemPrompt --> SkillLoader
    SystemPrompt --> AgentLoader
    
    %% Config
    Config --> dotenv
    
    %% Logging
    Logger --> logging
    Logger --> RotatingFileHandler
    
    %% External Dependencies
    subgraph "External Dependencies"
        httpx[httpx]
        yaml[PyYAML]
        dotenv[python-dotenv]
        logging[logging]
        RotatingFileHandler[logging.handlers]
        asyncio[asyncio]
        platform[platform]
        datetime[datetime]
        pathlib[pathlib]
        os[os]
        sys[sys]
        re[re]
        glob[glob]
        json[json]
    end
    
    OpenAICompatibleProvider -.-> httpx
    SkillLoader -.-> yaml
    AgentLoader -.-> yaml
    Config -.-> dotenv
    Logger -.-> logging
    Logger -.-> RotatingFileHandler
    BashTool -.-> asyncio
    SystemPrompt -.-> platform
    SystemPrompt -.-> datetime
    SystemPrompt -.-> os
    SystemPrompt -.-> pathlib
    ReadFileTool -.-> pathlib
    WriteFileTool -.-> pathlib
    EditFileTool -.-> pathlib
    GlobTool -.-> glob
    GrepTool -.-> re
    GrepTool -.-> pathlib
    BashTool -.-> pathlib
    CompletionResolver -.-> json
    
    %% Layer Boundaries
    classDef cliLayer fill:#e1f5fe,stroke:#01579b
    classDef agentLayer fill:#f3e5f5,stroke:#4a148c
    classDef providerLayer fill:#e8f5e9,stroke:#1b5e20
    classDef typesLayer fill:#fff3e0,stroke:#e65100
    classDef toolsLayer fill:#fce4ec,stroke:#880e4f
    classDef permLayer fill:#f1f8e9,stroke:#33691e
    classDef configLayer fill:#ede7f6,stroke:#311b92
    classDef skillsLayer fill:#e0f2f1,stroke:#004d40
    classDef promptLayer fill:#fff8e1,stroke:#f57f17
    classDef logLayer fill:#efebe9,stroke:#3e2723
    classDef extLayer fill:#f5f5f5,stroke:#757575,stroke-dasharray: 5 5
    
    class CLI cliLayer
    class AgentLoop,AgentState,CompletionResolver,CompletionResult agentLayer
    class Provider,OpenAICompatibleProvider,AnthropicProvider,GeminiProvider,ProviderTimeoutError,ProviderAuthenticationError providerLayer
    class Types,Role,StopReason,TextBlock,ToolCall,ToolResult,ReasoningBlock,Message,ToolSchema,ModelResponse,Tool typesLayer
    class ToolRegistry,ReadFileTool,WriteFileTool,EditFileTool,GlobTool,GrepTool,BashTool,AskUserTool,PlanTool,ToolSchemaFactory toolsLayer
    class PermissionGate,PathValidation,DenyList,Truncation permLayer
    class Config configLayer
    class Skill,SkillLoader,Agent,AgentLoader skillsLayer
    class SystemPrompt promptLayer
    class Logger logLayer
    class httpx,yaml,dotenv,logging,RotatingFileHandler,asyncio,platform,datetime,pathlib,os,sys,re,glob,json extLayer
