classDiagram
    %% Core Types
    class Role {
        <<enumeration>>
        USER
        ASSISTANT
        TOOL
    }

    class StopReason {
        <<enumeration>>
        END_TURN
        MAX_TOKENS
        TOOL_USE
        ERROR
    }

    class Block {
        <<interface>>
    }

    class TextBlock {
        +text: str
        +type: Literal["text"]
    }

    class ToolCall {
        +id: str
        +name: str
        +arguments: dict[str, Any]
        +type: Literal["tool_call"]
    }

    class ToolResult {
        +call_id: str
        +output: str
        +is_error: bool
        +type: Literal["tool_result"]
    }

    class ReasoningBlock {
        +text: str
        +type: Literal["reasoning"]
    }

    class Message {
        +role: Role
        +content: list[Block]
        +user(text: str) Message
        +assistant(blocks: list[Block]) Message
        +tool_result(call_id: str, output: str, is_error: bool) Message
    }

    class ToolSchema {
        +name: str
        +description: str
        +parameters: dict[str, Any]
    }

    class ModelResponse {
        +blocks: list[Block]
        +stop_reason: StopReason
        +usage: dict[str, int] | None
    }

    class Tool {
        <<interface>>
        +name: str
        +description: str
        +schema: ToolSchema
        +execute(**kwargs: Any) str
    }

    %% Agent State & Loop
    class AgentState {
        +messages: list[Message]
        +step_count: int
        +last_tool_calls: list[tuple[str, dict[str, Any]]]
        +model_output_limit_reached: bool
    }

    class AgentLoop {
        +provider: Provider
        +registry: ToolRegistry
        +permission_gate: PermissionGate
        +system_prompt: str
        +max_steps: int
        +permission_callback: Callable
        +reasoning_callback: Callable
        +tool_callback: Callable
        +clarification_callback: Callable
        +context_window_tokens: int
        +max_completion_tokens: int
        +state: AgentState
        +add_user_message(text: str) None
        +run(noTool: bool, custom_prompt: str) str
        +_execute_tool(tool_call: ToolCall) ToolResult
        +_log_context_usage(response: ModelResponse) None
        +clear_history() None
    }

    %% Provider Layer
    class Provider {
        <<interface>>
        +complete(system: str | None, messages: list[Message], tools: list[ToolSchema]) ModelResponse
    }

    class OpenAICompatibleProvider {
        +base_url: str
        +api_key: str
        +model: str
        +timeout: float
        +max_completion_tokens: int
        +_client: httpx.AsyncClient
        +complete(system, messages, tools) ModelResponse
        +_build_payload(system, messages, tools) dict
        +_convert_message(msg: Message) dict
        +_convert_tool_schema(tool: ToolSchema) dict
        +_parse_response(data: dict) ModelResponse
        +close() None
    }

    class ProviderTimeoutError {
        <<exception>>
    }

    class ProviderAuthenticationError {
        <<exception>>
    }

    class AnthropicProvider {
        <<stub>>
        +complete(system, messages, tools) ModelResponse
    }

    class GeminiProvider {
        <<stub>>
        +complete(system, messages, tools) ModelResponse
    }

    %% Tool Registry
    class ToolRegistry {
        -_tools: dict[str, Tool]
        +register(tool: Tool) None
        +get(name: str) Tool | None
        +all() list[Tool]
        +schemas() list[ToolSchema]
        +execute(name: str, **kwargs: Any) str
    }

    %% Tools
    class ReadFileTool {
        +project_root: Path
        +_truncate: Callable
        +execute(path: str, offset: int | None, limit: int | None) str
    }

    class WriteFileTool {
        +project_root: Path
        +execute(path: str, content: str) str
    }

    class EditFileTool {
        +project_root: Path
        +execute(path: str, old_string: str, new_string: str) str
        +_get_context(content: str, search: str) str
    }

    class GlobTool {
        +project_root: Path
        +_truncate: Callable
        +execute(pattern: str) str
    }

    class GrepTool {
        +project_root: Path
        +_truncate: Callable
        +execute(pattern: str, path: str, include: str | None) str
    }

    class BashTool {
        +project_root: Path
        +_truncate: Callable
        +execute(command: str, timeout_seconds: int, workdir: str | None) str
    }

    class AskUserTool {
        +ask_callback: AskCallback
        +execute(question: str, options: list[str] | None) str
    }

    class PlanTool {
        +plan_callback: PlanCallback
        +execute(title: str, summary: str, steps: list[str], risks: list[str]) str
    }

    %% Permissions
    class PermissionGate {
        -_always_allow: set[str]
        -_auto_allow: set[str]
        +check(tool_name: str, args: dict[str, Any]) tuple[bool, str | None]
        +allow_always(tool_name: str) None
        +allow_auto(tool_name: str) None
        +deny(tool_name: str) None
        +reset() None
    }

    class PathValidationError {
        <<exception>>
    }

    class TruncationError {
        <<exception>>
    }

    %% Skills & Agents
    class Skill {
        +name: str
        +description: str
        +path: Path
        +metadata: dict[str, Any]
        +content: str
        +load(skill_dir: Path) Skill
    }

    class SkillLoader {
        +skills_dir: Path
        -_skills: dict[str, Skill]
        +discover() dict[str, Skill]
        +get(name: str) Skill | None
        +all() list[Skill]
        +format_for_prompt() str
    }

    class Agent {
        +name: str
        +description: str
        +model: str
        +system_prompt: str
        +tools: list[str]
        +permissions: dict[str, str]
        +metadata: dict[str, Any]
        +content: str
        +load(agent_file: Path) Agent
        +format_for_prompt() str
    }

    class AgentLoader {
        +agents_dir: Path
        +default_agents_md: Path | None
        -_agents: dict[str, Agent]
        +discover() dict[str, Agent]
        +get(name: str) Agent | None
        +all() list[Agent]
        +format_for_prompt() str
        +_load_agents_md(path: Path) None
    }

    %% Config
    class Config {
        +base_url: str
        +api_key: str
        +model: str
        +request_timeout_seconds: float
        +max_completion_tokens: int
        +context_window_tokens: int
        +max_completion_attempts: int
        +max_output_size: int
        +max_steps: int
        +project_root: Path
        +from_env(env_file: Path | None) Config
    }

    %% Completion
    class CompletionResult {
        +response: str
        +complete: bool
        +attempts: int
        +findings: str
    }

    class CompletionResolver {
        +provider: Provider
        +max_attempts: int
        +run(agent: AgentLoop, original_request: str, normalized_request: str) CompletionResult
        +_build_review_input(...) str
        +_format_message(message: Message) dict
        +_parse_review(blocks: list[Any]) CompletionResult
    }

    %% CLI
    class CLI {
        +config: Config
        +provider: OpenAICompatibleProvider | None
        +registry: ToolRegistry
        +permission_gate: PermissionGate
        +agent_loop: AgentLoop | None
        +input_normalizer_loop: AgentLoop | None
        +completion_resolver: CompletionResolver | None
        +running: bool
        +skill_loader: SkillLoader
        +agent_loader: AgentLoader
        +initialize() None
        +run() None
        +handle_input(user_input: str) None
        +handle_slash_command(cmd: str) None
        +_permission_callback(tool_name: str, args: dict) tuple[bool, str | None]
        +_tool_callback(tool_name: str, args: dict, output: str, is_error: bool) None
        +_reasoning_callback(reasoning: str) None
        +_ask_user(question: str, options: list[str] | None) str
        +_clarify_empty_response(question: str) str
        +_present_plan(title, summary, steps, risks) str
    }

    %% Relationships
    Block <|-- TextBlock
    Block <|-- ToolCall
    Block <|-- ToolResult
    Block <|-- ReasoningBlock

    Message --> Block : contains
    Message --> Role : uses

    ModelResponse --> Block : contains
    ModelResponse --> StopReason : uses

    Tool <|-- ReadFileTool
    Tool <|-- WriteFileTool
    Tool <|-- EditFileTool
    Tool <|-- GlobTool
    Tool <|-- GrepTool
    Tool <|-- BashTool
    Tool <|-- AskUserTool
    Tool <|-- PlanTool

    ToolRegistry --> Tool : manages
    ToolRegistry --> ToolSchema : exposes

    Provider <|-- OpenAICompatibleProvider
    Provider <|-- AnthropicProvider
    Provider <|-- GeminiProvider

    AgentLoop --> Provider : uses
    AgentLoop --> ToolRegistry : uses
    AgentLoop --> PermissionGate : uses
    AgentLoop --> AgentState : has

    AgentLoop --> AgentState : creates
    AgentState --> Message : contains

    CompletionResolver --> Provider : uses
    CompletionResolver --> AgentLoop : uses
    CompletionResolver --> Message : uses

    CLI --> Config : uses
    CLI --> OpenAICompatibleProvider : creates
    CLI --> ToolRegistry : creates
    CLI --> PermissionGate : creates
    CLI --> AgentLoop : creates
    CLI --> CompletionResolver : creates
    CLI --> SkillLoader : creates
    CLI --> AgentLoader : creates

    SkillLoader --> Skill : loads
    AgentLoader --> Agent : loads

    ReadFileTool --> validate_path : uses
    WriteFileTool --> validate_path : uses
    EditFileTool --> validate_path : uses
    GrepTool --> validate_path : uses
    BashTool --> validate_path : uses
    BashTool --> check_deny_list : uses

    OpenAICompatibleProvider --> HTTPXAsyncClient : uses