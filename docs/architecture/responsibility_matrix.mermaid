```mermaid
%% Responsibility Assignment Matrix (RAM) / CRC Cards
%% This diagram shows class responsibilities and collaborations

graph TB
    subgraph "Responsibility Matrix"
        direction TB
        
        %% CLI
        CLI[CLI<br/>cli.py]
        CLI_R1["R1: Initialize all components"]
        CLI_R2["R2: Run main event loop"]
        CLI_R3["R3: Handle user input & slash commands"]
        CLI_R4["R4: Manage permissions interactively"]
        CLI_R5["R5: Display formatted output (Rich)"]
        CLI_R6["R6: Coordinate agent loops"]
        
        %% AgentLoop
        AgentLoop[AgentLoop<br/>agent.py]
        AL_R1["R1: Execute agent reasoning loop"]
        AL_R2["R2: Manage conversation state"]
        AL_R3["R3: Call provider for completions"]
        AL_R4["R4: Execute tool calls with permissions"]
        AL_R5["R5: Handle token limits & continuations"]
        AL_R6["R6: Detect & prevent tool call loops"]
        AL_R7["R7: Log context usage"]
        AL_R8["R8: Invoke callbacks (reasoning, tool, permission)"]
        
        %% AgentState
        AgentState[AgentState<br/>agent.py]
        AS_R1["R1: Hold conversation messages"]
        AS_R2["R2: Track step count"]
        AS_R3["R3: Track last tool calls (loop detection)"]
        AS_R4["R4: Track output limit status"]
        
        %% CompletionResolver
        CompletionResolver[CompletionResolver<br/>completion.py]
        CR_R1["R1: Run completion review loop"]
        CR_R2["R2: Build review input from trace"]
        CR_R3["R3: Parse reviewer JSON response"]
        CR_R4["R4: Manage retry attempts"]
        CR_R5["R5: Inject review feedback into agent"]
        
        %% Provider Layer
        Provider[Provider<br/>provider.py]
        P_R1["R1: Abstract completion interface"]
        
        OpenAICompatibleProvider[OpenAICompatibleProvider<br/>provider.py]
        OP_R1["R1: HTTP communication with OpenAI-compatible API"]
        OP_R2["R2: Build request payload (messages, tools)"]
        OP_R3["R3: Convert Message/ToolSchema to API format"]
        OP_R4["R4: Parse API response to ModelResponse"]
        OP_R5["R5: Handle timeouts & auth errors"]
        OP_R6["R6: Manage httpx AsyncClient lifecycle"]
        
        %% Types
        Types[Types<br/>types.py]
        T_R1["R1: Define core data structures"]
        T_R2["R2: Message/Block/ToolCall/ToolResult"]
        T_R3["R3: Enums: Role, StopReason"]
        T_R4["R4: ToolSchema & ModelResponse"]
        T_R5["R5: Tool interface definition"]
        
        %% ToolRegistry
        ToolRegistry[ToolRegistry<br/>tools/registry.py]
        TR_R1["R1: Register & retrieve tools by name"]
        TR_R2["R2: Provide tool schemas for provider"]
        TR_R3["R3: Execute tools by name"]
        
        %% Tools
        ReadFileTool[ReadFileTool<br/>tools/read_file.py]
        RT_R1["R1: Read files with offset/limit"]
        RT_R2["R2: Validate path within project root"]
        RT_R3["R3: Truncate output"]
        RT_R4["R4: Format with line numbers"]
        
        WriteFileTool[WriteFileTool<br/>tools/write_file.py]
        WT_R1["R1: Write content to file"]
        WT_R2["R2: Create parent directories"]
        WT_R3["R3: Validate path within project root"]
        
        EditFileTool[EditFileTool<br/>tools/edit_file.py]
        ET_R1["R1: Replace exact string match"]
        ET_R2["R2: Validate unique match"]
        ET_R3["R3: Show context on failure"]
        ET_R4["R4: Validate path within project root"]
        
        GlobTool[GlobTool<br/>tools/glob_tool.py]
        GT_R1["R1: Find files matching glob pattern"]
        GT_R2["R2: Return sorted relative paths"]
        GT_R3["R3: Truncate output"]
        
        GrepTool[GrepTool<br/>tools/grep_tool.py]
        GR_R1["R1: Search regex in files"]
        GR_R2["R2: Return matches with file:line"]
        GR_R3["R3: Support include filter"]
        GR_R4["R4: Validate path within project root"]
        GR_R5["R5: Truncate output"]
        
        BashTool[BashTool<br/>tools/bash_tool.py]
        BT_R1["R1: Execute shell commands"]
        BT_R2["R2: Check deny list"]
        BT_R3["R3: Validate working directory"]
        BT_R4["R4: Capture stdout/stderr with timeout"]
        BT_R5["R5: Truncate output"]
        
        AskUserTool[AskUserTool<br/>tools/ask_tool.py]
        AT_R1["R1: Delegate user interaction to callback"]
        AT_R2["R2: Support fixed-choice questions"]
        
        PlanTool[PlanTool<br/>tools/plan_tool.py]
        PT_R1["R1: Delegate plan approval to callback"]
        PT_R2["R2: Validate plan structure"]
        
        %% Permissions
        PermissionGate[PermissionGate<br/>permissions.py]
        PG_R1["R1: Check tool permissions (always/auto/prompt)"]
        PG_R2["R2: Check bash deny list"]
        PG_R3["R3: Manage allow/deny lists"]
        PG_R4["R4: Reset permissions"]
        
        PathValidation[PathValidation<br/>permissions.py]
        PV_R1["R1: Resolve & validate paths within project root"]
        PV_R2["R2: Prevent directory traversal"]
        
        DenyList[DenyList<br/>permissions.py]
        DL_R1["R1: Define dangerous command patterns"]
        DL_R2["R2: Check commands against patterns"]
        
        Truncation[Truncation<br/>permissions.py]
        TRUNC_R1["R1: Truncate output to max size"]
        TRUNC_R2["R2: Add truncation notice"]
        
        %% Config
        Config[Config<br/>config.py]
        CFG_R1["R1: Load config from env files"]
        CFG_R2["R2: Provide defaults"]
        CFG_R3["R3: Validate config values"]
        
        %% Skills & Agents
        Skill[Skill<br/>skills.py]
        SK_R1["R1: Load SKILL.md with frontmatter"]
        SK_R2["R2: Format for system prompt"]
        
        SkillLoader[SkillLoader<br/>skills.py]
        SL_R1["R1: Discover skills in directory"]
        SL_R2["R2: Load & cache skills"]
        SL_R3["R3: Format all skills for prompt"]
        
        Agent[Agent<br/>agents.py]
        AG_R1["R1: Load agent .md with frontmatter"]
        AG_R2["R2: Format for system prompt"]
        
        AgentLoader[AgentLoader<br/>agents.py]
        ALD_R1["R1: Discover agents in directory"]
        ALD_R2["R2: Load agents.md default config"]
        ALD_R3["R3: Cache & retrieve agents"]
        ALD_R4["R4: Format all agents for prompt"]
        
        %% System Prompt
        SystemPrompt[SystemPrompt<br/>system_prompt.py]
        SP_R1["R1: Build system prompt template"]
        SP_R2["R2: Inject tool descriptions"]
        SP_R3["R3: Inject skills & agents info"]
        SP_R4["R4: Load AGENT.md project instructions"]
        SP_R5["R5: Build input normalizer prompt"]
        
        %% Logger
        Logger[Logger<br/>logger.py]
        LG_R1["R1: Setup rotating file + console logging"]
        LG_R2["R2: Provide typed log functions"]
        LG_R3["R3: Log tool calls, permissions, commands, reasoning"]
    end
    
