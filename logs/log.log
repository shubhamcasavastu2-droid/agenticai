      AL_R5["R5: Handle token limits & continuations"]\n        AL_R6["R6: Detect & prevent tool call loops"]\n        AL_R7["R7: Log context usage"]\n        AL_R8["R8: Invoke callbacks (reasoning, tool, permission)"]\n        \n        %% AgentState\n        AgentState[AgentState<br/>agent.py]\n        AS_R1["R1: Hold conversation messages"]\n        AS_R2["R2: Track step count"]\n        AS_R3["R3: Track last tool calls (loop detection)"]\n        AS_R4["R4: Track output limit status"]\n        \n        %% CompletionResolver\n        CompletionResolver[CompletionResolver<br/>completion.py]\n        CR_R1["R1: Run completion review loop"]\n        CR_R2["R2: Build review input from trace"]\n        CR_R3["R3: Parse reviewer JSON response"]\n        CR_R4["R4: Manage retry attempts"]\n        CR_R5["R5: Inject review feedback into agent"]\n        \n        %% Provider Layer\n        Provider[Provider<br/>provider.py]\n        P_R1["R1: Abstract completion interface"]\n        \n        OpenAICompatibleProvider[OpenAICompatibleProvider<br/>provider.py]\n        OP_R1["R1: HTTP communication with OpenAI-compatible API"]\n        OP_R2["R2: Build request payload (messages, tools)"]\n        OP_R3["R3: Convert Message/ToolSchema to API format"]\n        OP_R4["R4: Parse API response to ModelResponse"]\n        OP_R5["R5: Handle timeouts & auth errors"]\n        OP_R6["R6: Manage httpx AsyncClient lifecycle"]\n        \n        %% Types\n        Types[Types<br/>types.py]\n        T_R1["R1: Define core data structures"]\n        T_R2["R2: Message/Block/ToolCall/ToolResult"]\n        T_R3["R3: Enums: Role, StopReason"]\n        T_R4["R4: ToolSchema & ModelResponse"]\n        T_R5["R5: Tool interface definition"]\n        \n        %% ToolRegistry\n        ToolRegistry[ToolRegistry<br/>tools/registry.py]\n        TR_R1["R1: Register & retrieve tools by name"]\n        TR_R2["R2: Provide tool schemas for provider"]\n        TR_R3["R3: Execute tools by name"]\n        \n        %% Tools\n        ReadFileTool[ReadFileTool<br/>tools/read_file.py]\n        RT_R1["R1: Read files with offset/limit"]\n        RT_R2["R2: Validate path within project root"]\n        RT_R3["R3: Truncate output"]\n        RT_R4["R4: Format with line numbers"]\n        \n        WriteFileTool[WriteFileTool<br/>tools/write_file.py]\n        WT_R1["R1: Write content to file"]\n        WT_R2["R2: Create parent directories"]\n        WT_R3["R3: Validate path within project root"]\n        \n        EditFileTool[EditFileTool<br/>tools/edit_file.py]\n        ET_R1["R1: Replace exact string match"]\n        ET_R2["R2: Validate unique match"]\n        ET_R3["R3: Show context on failure"]\n        ET_R4["R4: Validate path within project root"]\n        \n        GlobTool[GlobTool<br/>tools/glob_tool.py]\n        GT_R1["R1: Find files matching glob pattern"]\n        GT_R2["R2: Return sorted relative paths"]\n        GT_R3["R3: Truncate output"]\n        \n        GrepTool[GrepTool<br/>tools/grep_tool.py]\n        GR_R1["R1: Search regex in files"]\n        GR_R2["R2: Return matches with file:line"]\n        GR_R3["R3: Support include filter"]\n        GR_R4["R4: Validate path within project root"]\n        GR_R5["R5: Truncate output"]\n        \n        BashTool[BashTool<br/>tools/bash_tool.py]\n        BT_R1["R1: Execute shell commands"]\n        BT_R2["R2: Check deny list"]\n        BT_R3["R3: Validate working directory"]\n        BT_R4["R4: Capture stdout/stderr with timeout"]\n        BT_R5["R5: Truncate output"]\n        \n        AskUserTool[AskUserTool<br/>tools/ask_tool.py]\n        AT_R1["R1: Delegate user interaction to callback"]\n        AT_R2["R2: Support fixed-choice questions"]\n        \n        PlanTool[PlanTool<br/>tools/plan_tool.py]\n        PT_R1["R1: Delegate plan approval to callback"]\n        PT_R2["R2: Validate plan structure"]\n        \n        %% Permissions\n        PermissionGate[PermissionGate<br/>permissions.py]\n        PG_R1["R1: Check tool permissions (always/auto/prompt)"]\n        PG_R2["R2: Check bash deny list"]\n        PG_R3["R3: Manage allow/deny lists"]\n        PG_R4["R4: Reset permissions"]\n        \n        PathValidation[PathValidation<br/>permissions.py]\n        PV_R1["R1: Resolve & validate paths within project root"]\n        PV_R2["R2: Prevent directory traversal"]\n        \n        DenyList[DenyList<br/>permissions.py]\n        DL_R1["R1: Define dangerous command patterns"]\n        DL_R2["R2: Check commands against patterns"]\n        \n        Truncation[Truncation<br/>permissions.py]\n        TRUNC_R1["R1: Truncate output to max size"]\n        TRUNC_R2["R2: Add truncation notice"]\n        \n        %% Config\n        Config[Config<br/>config.py]\n        CFG_R1["R1: Load config from env files"]\n        CFG_R2["R2: Provide defaults"]\n        CFG_R3["R3: Validate config values"]\n        \n        %% Skills & Agents\n        Skill[Skill<br/>skills.py]\n        SK_R1["R1: Load SKILL.md with frontmatter"]\n        SK_R2["R2: Format for system prompt"]\n        \n        SkillLoader[SkillLoader<br/>skills.py]\n        SL_R1["R1: Discover skills in directory"]\n        SL_R2["R2: Load & cache skills"]\n        SL_R3["R3: Format all skills for prompt"]\n        \n        Agent[Agent<br/>agents.py]\n        AG_R1["R1: Load agent .md with frontmatter"]\n        AG_R2["R2: Format for system prompt"]\n        \n        AgentLoader[AgentLoader<br/>agents.py]\n        ALD_R1["R1: Discover agents in directory"]\n        ALD_R2["R2: Load agents.md default config"]\n        ALD_R3["R3: Cache & retrieve agents"]\n        ALD_R4["R4: Format all agents for prompt"]\n        \n        %% System Prompt\n        SystemPrompt[SystemPrompt<br/>system_prompt.py]\n        SP_R1["R1: Build system prompt template"]\n        SP_R2["R2: Inject tool descriptions"]\n        SP_R3["R3: Inject skills & agents info"]\n        SP_R4["R4: Load AGENT.md project instructions"]\n        SP_R5["R5: Build input normalizer prompt"]\n        \n        %% Logger\n        Logger[Logger<br/>logger.py]\n        LG_R1["R1: Setup rotating file + console logging"]\n        LG_R2["R2: Provide typed log functions"]\n        LG_R3["R3: Log tool calls, permissions, commands, reasoning"]\n    end\n    \n    %% Collaborations (key ones)\n    CLI -.->|uses| AgentLoop\n    CLI -.->|uses| CompletionResolver\n    CLI -.->|uses| ToolRegistry\n    CLI -.->|uses| PermissionGate\n    CLI -.->|uses| SkillLoader\n    CLI -.->|uses| AgentLoader\n    CLI -.->|uses| SystemPrompt\n    CLI -.->|uses| Config\n    CLI -.->|uses| OpenAICompatibleProvider\n    CLI -.->|uses| Logger\n    \n    AgentLoop -.->|uses| Provider\n    AgentLoop -.->|uses| ToolRegistry\n    AgentLoop -.->|uses| PermissionGate\n    AgentLoop -.->|uses| Types\n    AgentLoop -.->|has| AgentState\n    AgentLoop -.->|uses| Logger\n    \n    AgentState -.->|contains| Types\n    \n    CompletionResolver -.->|uses| Provider\n    CompletionResolver -.->|uses| AgentLoop\n    CompletionResolver -.->|uses| Types\n    CompletionResolver -.->|uses| Logger\n    \n    OpenAICompatibleProvider -.->|implements| Provider\n    OpenAICompatibleProvider -.->|uses| Types\n    OpenAICompatibleProvider -.->|uses| httpx\n    \n    ToolRegistry -.->|manages| Tool\n    ToolRegistry -.->|exposes| ToolSchema\n    \n    ReadFileTool -.->|implements| Tool\n    ReadFileTool -.->|uses| PathValidation\n    ReadFileTool -.->|uses| Truncation\n    \n    WriteFileTool -.->|implements| Tool\n    WriteFileTool -.->|uses| PathValidation\n    \n    EditFileTool -.->|implements| Tool\n    EditFileTool -.->|uses| PathValidation\n    \n    GlobTool -.->|implements| Tool\n    GlobTool -.->|uses| Truncation\n    \n    GrepTool -.->|implements| Tool\n    GrepTool -.->|uses| PathValidation\n    GrepTool -.->|uses| Truncation\n    \n    BashTool -.->|implements| Tool\n    BashTool -.->|uses| PathValidation\n    BashTool -.->|uses| Truncation\n    BashTool -.->|uses| DenyList\n    \n    AskUserTool -.->|implements| Tool\n    PlanTool -.->|implements| Tool\n    \n    PermissionGate -.->|uses| DenyList\n    \n    SkillLoader -.->|loads| Skill\n    AgentLoader -.->|loads| Agent\n    \n    SystemPrompt -.->|uses| Config\n    SystemPrompt -.->|uses| ToolRegistry\n    SystemPrompt -.->|uses| SkillLoader\n    SystemPrompt -.->|uses| AgentLoader\n    \n    %% Style\n    classDef component fill:#e3f2fd,stroke:#1565c0,stroke-width:2px\n    classDef responsibility fill:#fff3e0,stroke:#ef6c00,stroke-width:1px,stroke-dasharray: 5 5\n    classDef collaboration fill:#fce4ec,stroke:#c2185b,stroke-width:1px,stroke-dasharray: 5 5\n    \n    class CLI,AgentLoop,AgentState,CompletionResolver,Provider,OpenAICompatibleProvider,Types,ToolRegistry,ReadFileTool,WriteFileTool,EditFileTool,GlobTool,GrepTool,BashTool,AskUserTool,PlanTool,PermissionGate,PathValidation,DenyList,Truncation,Config,Skill,SkillLoader,Agent,AgentLoader,SystemPrompt,Logger component\n</div>\n\n        <h2>Responsibility Assignment Matrix (Tabular View)</h2>\n        \n        <table>\n            <thead>\n                <tr>\n                    <th>Component</th>\n                    <th>Primary Responsibilities</th>\n                    <th>Key Collaborators</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td class="component-name">CLI (cli.py)</td>\n                    <td>Initialize components, run event loop, handle input/commands, manage permissions, display output</td>\n                    <td>AgentLoop, CompletionResolver, ToolRegistry, PermissionGate, SkillLoader, AgentLoader, SystemPrompt, Config, Provider, Logger</td>\n                </tr>\n                <tr>\n                    <td class="component-name">AgentLoop (agent.py)</td>\n                    <td>Execute reasoning loop, manage state, call provider, execute tools, handle limits, prevent loops</td>\n                    <td>Provider, ToolRegistry, Permissi