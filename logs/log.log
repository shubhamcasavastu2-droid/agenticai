vg viewBox="0 0 1000 600" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="resp-title resp-desc">\n      <title id="resp-title">AI Agent CLI · Component responsibilities</title>\n      <desc id="resp-desc">Swimlane diagram showing responsibilities across layers: CLI (entry, config, initialization), Agent Layer (orchestration, state, callbacks), Provider Layer (model completion, API), Tools Layer (file ops, shell, user interaction), Core Types (data structures), External (dependencies).</desc>\n      <defs>\n        <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse">\n          <circle cx="1" cy="1" r="0.9" fill="rgba(45,49,66,0.10)"/>\n        </pattern>\n        <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#4f5d75"/></marker>\n        <marker id="arrow-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#bf4520"/></marker>\n      </defs>\n\n      <rect width="100%" height="100%" fill="#f5f5f5"/>\n      <rect width="100%" height="100%" fill="url(#dots)" opacity="0.55"/>\n\n      <!-- Lane dividers (horizontal) -->\n      <line x1="40" y1="80" x2="960" y2="80" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="40" y1="160" x2="960" y2="160" stroke="rgba(45,49,66,0.10)" stroke-width="1"/>\n      <line x1="40" y1="240" x2="960" y2="240" stroke="rgba(45,49,66,0.10)" stroke-width="1"/>\n      <line x1="40" y1="320" x2="960" y2="320" stroke="rgba(45,49,66,0.10)" stroke-width="1"/>\n      <line x1="40" y1="400" x2="960" y2="400" stroke="rgba(45,49,66,0.10)" stroke-width="1"/>\n      <line x1="40" y1="480" x2="960" y2="480" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n\n      <!-- Actor column divider -->\n      <line x1="160" y1="80" x2="160" y2="480" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n\n      <!-- Lane labels -->\n      <text x="60" y="124" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">CLI</text>\n      <text x="60" y="204" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">AGENT LAYER</text>\n      <text x="60" y="284" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">PROVIDER</text>\n      <text x="60" y="364" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">TOOLS</text>\n      <text x="60" y="444" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">CORE TYPES</text>\n      <text x="60" y="524" fill="#4f5d75" font-size="9" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">EXTERNAL</text>\n\n      <!-- Arrows (drawn first) -->\n      <!-- CLI -> AgentLoop: initialize -->\n      <path d="M 300,120 H 352 Q 360,120 360,128 V 176" fill="none" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-accent)"/>\n      <!-- AgentLoop -> Provider: complete -->\n      <path d="M 500,224 H 552 Q 560,224 560,232 V 276" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n      <!-- Provider -> AgentLoop: ModelResponse -->\n      <path d="M 500,280 H 448 Q 440,280 440,272 V 220" fill="none" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-accent)"/>\n      <!-- AgentLoop -> ToolRegistry: execute -->\n      <path d="M 650,224 H 702 Q 710,224 710,232 V 336" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n      <!-- ToolRegistry -> Concrete Tool: execute -->\n      <path d="M 650,360 H 702 Q 710,360 710,368 V 420" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n      <!-- Concrete Tool -> validate_path -->\n      <path d="M 850,380 H 902 Q 910,380 910,388 V 440" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n      <!-- AgentLoop -> PermissionGate: check -->\n      <path d="M 300,224 H 352 Q 360,224 360,