op: 0.25rem;\n    }\n  </style>\n</head>\n<body>\n  <header>\n    <p class="eyebrow">Diagram Design · Architecture</p>\n    <h1>AI Agent CLI Architecture</h1>\n    <p>Comprehensive architectural documentation using the Diagram Design editorial design system</p>\n  </header>\n\n  <div class="container">\n    <div class="stats">\n      <div class="stat">\n        <span class="stat-number">7</span>\n        <span class="stat-label">Diagrams</span>\n      </div>\n      <div class="stat">\n        <span class="stat-number">45+</span>\n        <span class="stat-label">Classes</span>\n      </div>\n      <div class="stat">\n        <span class="stat-number">3</span>\n        <span class="stat-label">Sequence Flows</span>\n      </div>\n      <div class="stat">\n        <span class="stat-number">100%</span>\n        <span class="stat-label">Design System</span>\n      </div>\n    </div>\n\n    <!-- Class Diagrams Section -->\n    <section class="section">\n      <div class="section-header">\n        <p class="eyebrow">UML Class Diagrams</p>\n        <h2>Static Structure</h2>\n      </div>\n\n      <div class="diagram-grid">\n        <div class="diagram-card">\n          <p class="category">UML Class</p>\n          <h2>Core Types & Message Model</h2>\n          <p>Enumerations (Role, StopReason), Block interface with four implementations (TextBlock, ToolCall, ToolResult, ReasoningBlock), Message with factory methods, ToolSchema, ModelResponse, and Tool interface.</p>\n          <div class="tags">\n            <span class="tag">Enumerations</span>\n            <span class="tag">Interface</span>\n            <span class="tag">Realization</span>\n            <span class="tag accent">Focal: Block</span>\n          </div>\n          <a href="diagram-design/class-core-types.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>class-core-types.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">UML Class</p>\n          <h2>Agent Layer: State & Loop</h2>\n          <p>AgentState containing Messages, and AgentLoop depending on Provider, ToolRegistry, PermissionGate with callbacks, owning AgentState via composition.</p>\n          <div class="tags">\n            <span class="tag">Composition</span>\n            <span class="tag">Dependency</span>\n            <span class="tag">Callbacks</span>\n            <span class="tag accent">Focal: AgentLoop</span>\n          </div>\n          <a href="diagram-design/class-agent-layer.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>class-agent-layer.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">UML Class</p>\n          <h2>Provider Layer</h2>\n          <p>Provider interface realized by OpenAICompatibleProvider (full implementation) with AnthropicProvider and GeminiProvider as stubs. Custom exceptions for timeout and authentication errors.</p>\n          <div class="tags">\n            <span class="tag">Realization</span>\n            <span class="tag">Stubs</span>\n            <span class="tag">Exceptions</span>\n            <span class="tag accent">Focal: Provider</span>\n          </div>\n          <a href="diagram-design/class-provider-layer.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>class-provider-layer.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">UML Class</p>\n          <h2>Tools Layer</h2>\n          <p>Tool interface realized by 7 concrete tools (ReadFileTool, WriteFileTool, EditFileTool, GlobTool, GrepTool, BashTool, AskUserTool, PlanTool), managed by ToolRegistry with external validation functions.</p>\n          <div class="tags">\n            <span class="tag">7 Tools</span>\n            <span class="tag">Registry</span>\n            <span class="tag">External Fns</span>\n            <span class="tag accent">Focal: Tool</span>\n          </div>\n          <a href="diagram-design/class-tools-layer.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>class-tools-layer.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">Tree</p>\n          <h2>Class Hierarchy Tree</h2>\n          <p>Hierarchical view of all inheritance and realization relationships: Block→4 implementations, Provider→3 implementations, Tool→7 implementations, plus enumerations Role and StopReason.</p>\n          <div class="tags">\n            <span class="tag">Inheritance</span>\n            <span class="tag">Realization</span>\n            <span class="tag">Enumerations</span>\n            <span class="tag accent">Focal: Interfaces</span>\n          </div>\n          <a href="diagram-design/hierarchy-class-tree.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>hierarchy-class-tree.html</code></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Architecture Section -->\n    <section class="section">\n      <div class="section-header">\n        <p class="eyebrow">Architecture Diagram</p>\n        <h2>Layered System Overview</h2>\n      </div>\n\n      <div class="diagram-grid">\n        <div class="diagram-card" style="grid-column: 1 / -1;">\n          <p class="category">Architecture</p>\n          <h2>AI Agent CLI · Layered Architecture</h2>\n          <p>Six-layer architecture: CLI (entry point), Agent Layer (AgentLoop orchestrator, AgentState), Provider Layer (Provider interface + implementations), Tools Layer (ToolRegistry + 7 tools), Core Types (messages, blocks, schemas), External Dependencies (httpx, stdlib, config). Shows primary flow, dependencies, and trust boundaries.</p>\n          <div class="tags">\n            <span class="tag">6 Layers</span>\n            <span class="tag">Trust Boundaries</span>\n            <span class="tag">Primary Flow</span>\n            <span class="tag accent">Focal: AgentLoop</span>\n          </div>\n          <a href="diagram-design/architecture-layers.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>architecture-layers.html</code></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Sequence Diagrams Section -->\n    <section class="section">\n      <div class="section-header">\n        <p class="eyebrow">Sequence Diagrams</p>\n        <h2>Behavioral Flows</h2>\n      </div>\n\n      <div class="diagram-grid">\n        <div class="diagram-card">\n          <p class="category">Sequence</p>\n          <h2>Main Agent Loop</h2>\n          <p>User request → CLI initialization → AgentLoop.run → Provider.complete → PermissionGate.check → ToolRegistry.execute → ToolResult → Provider.complete (with tools) → ModelResponse → User response. Includes optional tool execution loop fragment.</p>\n          <div class="tags">\n            <span class="tag">14 Messages</span>\n            <span class="tag">6 Lifelines</span>\n            <span class="tag">Opt Fragment</span>\n            <span class="tag accent">Focal: AgentLoop</span>\n          </div>\n          <a href="diagram-design/sequence-main-loop.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>sequence-main-loop.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">Sequence</p>\n          <h2>Tool Execution Flow</h2>\n          <p>AgentLoop checks PermissionGate → ToolRegistry.execute → Concrete Tool → validate_path → check_deny_list (BashTool) → tool executes → ToolResult returns up the chain. Includes alt fragment for denied permissions.</p>\n          <div class="tags">\n            <span class="tag">11 Messages</span>\n            <span class="tag">6 Lifelines</span>\n            <span class="tag">Alt Fragment</span>\n            <span class="tag accent">Focal: Concrete Tool</span>\n          </div>\n          <a href="diagram-design/sequence-tool-execution.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>sequence-tool-execution.html</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">Sequence</p>\n          <h2>Completion Review Loop</h2>\n          <p>CLI runs CompletionResolver → AgentLoop executes request → Provider returns response → CompletionResolver reviews via Provider → loop until complete or max attempts → CompletionResult returned to CLI. Includes loop and alt fragments.</p>\n          <div class="tags">\n            <span class="tag">9 Messages</span>\n            <span class="tag">4 Lifelines</span>\n            <span class="tag">Loop + Alt</span>\n            <span class="tag accent">Focal: CompletionResolver</span>\n          </div>\n          <a href="diagram-design/sequence-completion-review.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>sequence-completion-review.html</code></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Responsibility Section -->\n    <section class="section">\n      <div class="section-header">\n        <p class="eyebrow">Swimlane Diagram</p>\n        <h2>Cross-Layer Responsibilities</h2>\n      </div>\n\n      <div class="diagram-grid">\n        <div class="diagram-card" style="grid-column: 1 / -1;">\n          <p class="category">Swimlane</p>\n          <h2>Component Responsibilities</h2>\n          <p>Six swimlanes (CLI, Agent Layer, Provider, Tools, Core Types, External) showing each layer\'s responsibilities and critical handoffs: CLI initializes and runs, AgentLoop orchestrates, Provider completes, ToolRegistry manages tools, Core Types define data structures, External provides dependencies.</p>\n          <div class="tags">\n            <span class="tag">6 Lanes</span>\n            <span class="tag">Handoffs</span>\n            <span class="tag">RACI-style</span>\n            <span class="tag accent">Focal: AgentLoop</span>\n          </div>\n          <a href="diagram-design/responsibility-swimlane.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>responsibility-swimlane.html</code></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Legacy Diagrams Section -->\n    <section class="section">\n      <div class="section-header">\n        <p class="eyebrow">Legacy Mermaid Diagrams</p>\n        <h2>Original Mermaid Source</h2>\n      </div>\n\n      <div class="diagram-grid">\n        <div class="diagram-card">\n          <p class="category">Mermaid</p>\n          <h2>Class Diagram (Mermaid)</h2>\n          <p>Original comprehensive class diagram rendered via Mermaid.js. Includes all 50+ classes, interfaces, enums, and relationships in a single diagram.</p>\n          <div class="tags">\n            <span class="tag">Mermaid.js</span>\n            <span class="tag">Single Diagram</span>\n            <span class="tag">All Classes</span>\n          </div>\n          <a href="class_diagram.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>class_diagram.mermaid</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">Mermaid</p>\n          <h2>Package/Layer Diagram (Mermaid)</h2>\n          <p>Layered architecture showing module organization and dependencies across 10 architectural layers.</p>\n          <div class="tags">\n            <span class="tag">Mermaid.js</span>\n            <span class="tag">10 Layers</span>\n            <span class="tag">Dependencies</span>\n          </div>\n          <a href="package_layer_diagram.html" target="_blank">View Diagram →</a>\n          <div class="file-info">Source: <code>package_layer_diagram.mermaid</code></div>\n        </div>\n\n        <div class="diagram-card">\n          <p class="category">Mermaid</p>\n          <h2>Responsibility Matrix (Mermaid)</h2>\n          <p>Re