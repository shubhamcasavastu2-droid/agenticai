"/>\n      <line x1="250" y1="280" x2="450" y2="280" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="250" y1="320" x2="450" y2="320" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="350" y="264" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">WriteFileTool</text>\n      <text x="266" y="300" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ project_root: Path</text>\n      <text x="266" y="320" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(path, content): str</text>\n\n      <!-- EditFileTool -->\n      <rect x="450" y="240" width="200" height="120" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="450" y1="280" x2="650" y2="280" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="450" y1="320" x2="650" y2="320" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="450" y1="360" x2="650" y2="360" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="550" y="264" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">EditFileTool</text>\n      <text x="466" y="300" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ project_root: Path</text>\n      <text x="466" y="320" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(path, old, new): str</text>\n      <text x="466" y="340" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">- _get_context(...): str</text>\n\n      <!-- GlobTool -->\n      <rect x="650" y="240" width="200" height="100" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="650" y1="280" x2="850" y2="280" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="650" y1="320" x2="850" y2="320" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="750" y="264" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GlobTool</text>\n      <text x="666" y="300" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ project_root: Path</text>\n      <text x="666" y="320" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">- _truncate: Callable</text>\n      <text x="666" y="340" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(pattern): str</text>\n\n      <!-- Concrete Tools Row 2 -->\n      <!-- GrepTool -->\n      <rect x="50" y="480" width="200" height="100" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="50" y1="520" x2="250" y2="520" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="50" y1="560" x2="250" y2="560" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="150" y="504" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GrepTool</text>\n      <text x="66" y="540" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ project_root: Path</text>\n      <text x="66" y="560" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">- _truncate: Callable</text>\n      <text x="66" y="580" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(pattern, path,</text>\n      <text x="66" y="600" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">    include): str</text>\n\n      <!-- BashTool -->\n      <rect x="250" y="480" width="200" height="100" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="250" y1="520" x2="450" y2="520" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="250" y1="560" x2="450" y2="560" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="350" y="504" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">BashTool</text>\n      <text x="266" y="540" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ project_root: Path</text>\n      <text x="266" y="560" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">- _truncate: Callable</text>\n      <text x="266" y="580" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(cmd, timeout,</text>\n      <text x="266" y="600" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">    workdir): str</text>\n\n      <!-- AskUserTool -->\n      <rect x="450" y="480" width="200" height="100" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="450" y1="520" x2="650" y2="520" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="450" y1="560" x2="650" y2="560" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="550" y="504" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AskUserTool</text>\n      <text x="466" y="540" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ ask_callback: AskCallback</text>\n      <text x="466" y="560" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(question,</text>\n      <text x="466" y="580" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">    options): str</text>\n\n      <!-- PlanTool -->\n      <rect x="650" y="480" width="200" height="120" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <line x1="650" y1="520" x2="850" y2="520" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="650" y1="560" x2="850" y2="560" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <line x1="650" y1="600" x2="850" y2="600" stroke="rgba(45,49,66,0.22)" stroke-width="1"/>\n      <text x="750" y="504" fill="#2d3142" font-size="12" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">PlanTool</text>\n      <text x="666" y="540" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ plan_callback: PlanCallback</text>\n      <text x="666" y="560" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">+ execute(title, summary,</text>\n      <text x="666" y="580" fill="#2d3142" font-size="9" font-family="\'Geist Mono\', monospace">    steps, risks): str</text>\n\n      <!-- Legend: relationship vocabulary -->\n      <line x1="40" y1="630" x2="960" y2="630" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <text x="40" y="646" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" letter-spacing="0.18em">LEGEND · RELATIONSHIPS</text>\n\n      <line x1="40" y1="662" x2="68" y2="662" stroke="#bf4520" stroke-width="1" stroke-dasharray="5,4" marker-end="url(#uml-triangle-dashed)"/>\n      <text x="76" y="666" fill="#4f5d75" font-size="8.5" font-family="\'Geist\', sans-serif">Realization</text>\n\n      <line x1="220" y1="662" x2="248" y2="662" stroke="#2d3142" stroke-width="1" marker-start="url(#uml-diamond-filled)"/>\n      <text x="256" y="666" fill="#4f5d75" font-size="8.5" font-family="\'Geist\', sans-serif">Composition · manages</text>\n\n      <line x1="420" y1="662" x2="448" y2="662" stroke="#4f5d75" stroke-width="1" marker-end="url(#uml-open)"/>\n      <text x="456" y="666" fill="#4f5d75" font-size="8.5" font-family="\'Geist\', sans-serif">Association · exposes</text>\n\n      <line x1="620" y1="662" x2="648" y2="662" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#uml-open-dashed)"/>\n      <text x="656" y="666" fill="#4f5d75" font-size="8.5" font-family="\'Geist\', sans-serif">Dependency · uses</text>\n\n      <line x1="820" y1="662" x2="848" y2="662" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#uml-open-dashed)"/>\n      <text x="856" y="666" fill="#4f5d75" font-size="8.5" font-family="\'Geist\', sans-serif">External function</text>\n    </svg>\n  </div>\n</body>\n</html>', 'path': 'docs/architecture/diagram-design/class-tools-layer.html