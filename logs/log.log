', monospace" text-anchor="middle">base_url, api_key</text>\n      <text x="360" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">model, timeout</text>\n      <text x="360" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_client: HTTPXAsyncClient</text>\n\n      <!-- Stubs below -->\n      <rect x="60" y="400" width="180" height="40" rx="6" fill="#ffffff" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="150" y="424" fill="#bfc0c0" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AnthropicProvider</text>\n      <text x="150" y="440" fill="#bfc0c0" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«stub»</text>\n\n      <rect x="260" y="400" width="200" height="40" rx="6" fill="#ffffff" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="360" y="424" fill="#bfc0c0" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GeminiProvider</text>\n      <text x="360" y="440" fill="#bfc0c0" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«stub»</text>\n\n      <!-- Tools Layer (zone: 500-960, center=730) -->\n      <!-- ToolRegistry - left side -->\n      <rect x="520" y="272" width="180" height="116" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="296" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">ToolRegistry</text>\n      <text x="610" y="316" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_tools: dict</text>\n      <text x="610" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">register, get, all</text>\n      <text x="610" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle"