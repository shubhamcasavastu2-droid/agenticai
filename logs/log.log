ct x="132" y="592" width="14" height="10" rx="2" fill="rgba(191,69,32,0.08)" stroke="#bf4520" stroke-width="1"/>\n      <text x="152" y="600" fill="#4f5d75" font-size="8.5" font-family"\'Geist\', sans-serif">Focal responsibility</text>\n\n      <line x1="268" y1="598" x2="296" y2="598" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n      <text x="304" y="600" fill="#4f5d75" font-size="8.5" font-family"\'Geist\', sans-serif">Within-lane</text>\n\n      <line x1="444" y1="598" x2="472" y2="598" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-accent)"/>\n      <text x="480" y="600" fill="#4f5d75" font-size="8.5" font-family"\'Geist\', sans-serif">Critical handoff</text>\n\n      <line x1="608" y1="598" x2="636" y2="598" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow)"/>\n      <text x="644" y="600" fill="#4f5d75" font-size="8.5" font-family"\'Geist\', sans-serif">Optional / external</text>\n\n      <rect x="780" y="592" width="14" height="10" rx="2" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="800" y="600" fill="#4f5d75" font-size="8.5" font-family"\'Geist\', sans-serif">External dep</text>\n    </svg>\n  </div>\n</body>\n</html>'} output=started
