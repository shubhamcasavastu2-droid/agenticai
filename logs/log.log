5" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«enumeration»</text>\n\n      <rect x="280" y="610" width="160" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="360" y="634" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Tool</text>\n      <text x="360" y="650" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«interface»</text>\n\n      <!-- External Dependencies -->\n      <rect x="540" y="432" width="160" height="116" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="620" y="456" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">HTTPXAsyncClient</text>\n      <text x="620" y="476" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">httpx (async HTTP)</text>\n      <text x="620" y="496" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">OpenAI-compatible API</text>\n\n      <rect x="740" y="432" width="160" height="116" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="820" y="456" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">stdlib</text>\n      <text x="820" y="476" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">pathlib, subprocess</text>\n      <text x="820" y="496" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">asyncio, typing</text>\n\n      <rect x="540" y="560" width="160" height="40" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="620" y="584" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Config / .env</text>\n      <text x