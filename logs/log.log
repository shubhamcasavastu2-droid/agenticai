0" width="8" height="520" fill="rgba(45,49,66,0.06)" stroke="#4f5d75" stroke-width="0.8"/>\n      <!-- Provider activation -->\n      <rect x="636" y="200" width="8" height="120" fill="rgba(45,49,66,0.06)" stroke="#4f5d75" stroke-width="0.8"/>\n      <!-- ToolRegistry activation -->\n      <rect x="816" y="360" width="8" height="80" fill="rgba(45,49,66,0.06)" stroke="#4f5d75" stroke-width="0.8"/>\n      <!-- PermissionGate activation -->\n      <rect x="896" y="340" width="8" height="40" fill="rgba(45,49,66,0.06)" stroke="#4f5d75" stroke-width="0.8"/>\n\n      <!-- Messages -->\n      <!-- 1. User -> CLI: request -->\n      <line x1="100" y1="100" x2="280" y2="100" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="170" y="80" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="198" y="90" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">request</text>\n\n      <!-- 2. CLI -> AgentLoop: initialize -->\n      <line x1="280" y1="140" x2="460" y2="140" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-filled-accent)"/>\n      <rect x="340" y="120" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="364" y="130" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">initialize</text>\n\n      <!-- 3. CLI -> AgentLoop: add_user_message -->\n      <line x1="280" y1="180" x2="460" y2="180" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="340" y="160" width="72" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="376" y="170" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">add_user_message</text>\n\n      <!-- 4. CLI -> AgentLoop: run -->\n      <line x1="280" y1="220" x2="460" y2="220" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-filled-accent)"/>\n      <rect x="340" y="