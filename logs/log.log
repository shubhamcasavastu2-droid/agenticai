" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">check, allow, deny</text>\n      <text x="820" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">reset</text>\n\n      <!-- Concrete Tools (representative) -->\n      <rect x="540" y="400" width="160" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="620" y="424" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">ReadFileTool</text>\n      <text x="620" y="440" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="740" y="400" width="160" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="820" y="424" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">WriteFileTool</text>\n      <text x="820" y="440" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="540" y="450" width="160" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="620" y="474" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">EditFileTool</text>\n      <text x="620" y="490" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="740" y="450" width="160" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="820" y="474" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">BashTool</text>\n      <text x="820" y="490" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">command, timeout</text>\n\n      <rect x="540" y="500" width="160"