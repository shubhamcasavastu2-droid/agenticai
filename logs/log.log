nt-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">ModelResponse</text>\n      <text x="350" y="600" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">blocks, stop_reason</text>\n\n      <rect x="60" y="610" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="150" y="634" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Role, StopReason</text>\n      <text x="150" y="650" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«enumeration»</text>\n\n      <rect x="260" y="610" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="350" y="634" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Tool</text>\n      <text x="350" y="650" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«interface»</text>\n\n      <!-- External Dependencies (zone: 500-960, center=730) -->\n      <rect x="520" y="432" width="180" height="116" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="610" y="456" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">HTTPXAsyncClient</text>\n      <text x="610" y="476" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">httpx (async HTTP)</text>\n      <text x="610" y="496" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">OpenAI-compatible API</text>\n\n      <rect x="720" y="432" width="180" height="116" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="810" y="456" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">stdlib</text>\n      <text x="810" y="476" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">pathlib, subprocess</text>\n      <text x="810" y="496" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">asyncio, typing</text>\n\n      <rect x="520" y="560" width="180" height="40" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="610" y="584" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Config / .env</text>\n      <text x="610" y="600" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">environment config</text>\n\n      <rect x="720" y="560" width="180" height="40" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="810" y="584" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Skill / Agent files</text>\n      <text x="810" y="600" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">markdown configs</text>\n\n      <rect x="520" y="610" width="180" height="40" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="610" y="634" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">CompletionResolver</text>\n      <text x="610" y="650" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">review loop</text>\n\n      <rect x="720" y="610" width="180" height="40" rx="6" fill="#ececec" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="810" y="634" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Logging</text>\n      <text x="810" y="650" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">structured logs</text>\n\n      <!-- ============================================================\n           ARROWS (drawn after nodes, connecting to node edges)\n           ============================================================ -->\n      <!-- CLI (500,108 bottom) --> AgentLoop (350,152 top) -->\n      <path d="M 500,108 V 124 Q 500,130 470,130 H 350" fill="none" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-accent)"/>\n      <rect x="480" y="88" width="40" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="500" y="98" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.08em">RUNS</text>\n\n      <!-- AgentLoop (350,228 bottom) --> Provider (150,272 top) -->\n      <path d="M 350,228 V 244 Q 350,250 250,250 H 150" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop (350,228 bottom) --> ToolRegistry (610,272 top) -->\n      <path d="M 350,228 V 244 Q 350,250 450,250 H 610" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop (350,228 bottom) --> PermissionGate (810,272 top) -->\n      <path d="M 350,228 V 244 Q 350,250 550,250 H 810" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop (350,228 bottom) --> AgentState (650,152 top) - composition, goes up -->\n      <path d="M 350,228 V 210 Q 350,200 500,200 H 650 V 152" fill="none" stroke="#2d3142" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- Provider (150,388 bottom) --> Core Types (150,432 top) -->\n      <path d="M 150,388 V 432" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- ToolRegistry (610,388 bottom) --> Core Types (350,432 top) -->\n      <path d="M 610,388 V 404 Q 610,410 480,410 H 350 V 432" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- Tools (720,388 bottom) --> validate_path (external) -->\n      <path d="