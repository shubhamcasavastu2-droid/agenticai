abelledby="arch-title arch-desc">\n      <title id="arch-title">AI Agent CLI · Layered architecture</title>\n      <desc id="arch-desc">Architecture diagram showing 6 layers: CLI (entry point), Agent Layer (AgentLoop, AgentState), Provider Layer (Provider interface, implementations), Tools Layer (ToolRegistry, 7 tools), Core Types (messages, blocks, schemas), and External Dependencies (httpx, stdlib).</desc>\n      <defs>\n        <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#4f5d75"/>\n        </marker>\n        <marker id="arrow-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#bf4520"/>\n        </marker>\n        <marker id="arrow-link" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#2e5aa8"/>\n        </marker>\n        <marker id="arrow-dashed" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <path d="M0,0 L8,3 L0,6" fill="none" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3"/>\n        </marker>\n      </defs>\n\n      <rect width="100%" height="100%" fill="#f5f5f5"/>\n      <rect width="100%" height="100%" fill="url(#dots)" opacity="0.55"/>\n      <defs>\n        <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse">\n          <circle cx="1" cy="1" r="0.9" fill="rgba(45,49,66,0.10)"/>\n        </pattern>\n      </defs>\n\n      <!-- Zone: CLI Layer -->\n      <rect x="40" y="40" width="920" height="80" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="96" y="44" width="60" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="126" y="53" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">CLI</text>\n\n      <!-- Zone: Agent Layer -->\n      <rect x="40" y="140" width="920" height="100" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="96" y="144" width="84" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="138" y="153" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">AGENT LAYER</text>\n\n      <!-- Zone: Provider Layer -->\n      <rect x="40" y="260" width="440" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="96" y="264" width="96" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="144" y="273" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">PROVIDER</text>\n\n      <!-- Zone: Tools Layer -->\n      <rect x="500" y="260" width="460" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="556" y="264" width="72" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="592" y="273" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">TOOLS</text>\n\n      <!-- Zone: Core Types -->\n      <rect x="40" y="420" width="440" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="96" y="424" width="72" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="132" y="433" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">CORE TYPES</text>\n\n      <!-- Zone: External Dependencies -->\n      <rect x="500" y="420" width="460" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="556" y="424" width="108" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="610" y="433" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">EXTERNAL DEPS</text>\n\n      <!-- Arrows (drawn before nodes) -->\n      <!-- CLI --> AgentLoop -->\n      <path d="M 500,120 V 140" fill="none" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-accent)"/>\n\n      <!-- AgentLoop --> Provider -->\n      <path d="M 500,240 V 260" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop --> ToolRegistry -->\n      <path d="M 500,240 V 260" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop --> PermissionGate -->\n      <path d="M 500,240 V 260" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- AgentLoop --> AgentState (composition) -->\n      <path d="M 500,240 V 260" fill="none" stroke="#2d3142" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- Provider --> Core Types (Message, ToolSchema, ModelResponse) -->\n      <path d="M 260,400 V 420" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- ToolRegistry --> Core Types (Tool, ToolSchema) -->\n      <path d="M 730,400 V 420" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- Tools --> validate_path, check_deny_list -->\n      <path d="M 730,400 V 420" fill="none" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow-dashed)"/>\n\n      <!-- OpenAICompatibleProvider --> HTTPXAsyncClient -->\n      <path d="M 260,400 V 420" fill="none" stroke="#2e5aa8" stroke-width="1.2" marker-end="url(#arrow-link)"/>\n\n      <!-- CLI --> Config -->\n      <path d="M 500,120 V 140" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- CLI --> SkillLoader, AgentLoader -->\n      <path d="M 500,120 V 140" fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow)"/>\n\n      <!-- Arrow labels -->\n      <rect x="480" y="100" width="40" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="500" y="110" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.08em">RUNS</text>\n\n      <rect x="480" y="220" width="40" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="500" y="230" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.08em">USES</text>\n\n      <!-- Nodes -->\n      <!-- CLI -->\n      <rect x="440" y="52" width="120" height="56" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="500" y="84" fill="#bf4520" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">CLI</text>\n      <text x="500" y="100" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">entry point</text>\n\n      <!-- AgentLoop (focal) -->\n      <rect x="430" y="152" width="140" height="76" rx="6" fill="rgba(191,69,32,0.04)" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="500" y="176" fill="#bf4520" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AgentLoop</text>\n      <text x="500" y="196" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">orchestrator</text>\n      <text x="500" y="216" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">callbacks, state</text>\n\n      <!-- AgentState -->\n      <rect x="600" y="152" width="140" height="76" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="670" y="176" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AgentState</text>\n      <text x="670" y="196" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">messages, steps</text>\n      <text x="670" y="216" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">tool calls, limits</text>\n\n      <!-- Provider (interface) -->\n      <rect x="80" y="272" width="160" height="116" rx="6" fill="rgba(191,69,32,0.04)" stroke="#bf4520" stroke-width="1"/>\n      <rect x="80" y="272" width="160" height="32" rx="6" fill="rgba(191,69,32,0.10)"/>\n      <line x1="80" y1="304" x2="240" y2="304" stroke="rgba(191,69,32,0.40)" stroke-width="1"/>\n      <text x="160" y="292" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.08em">«interface»</text>\n      <text x="160" y="316" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Provider</text>\n      <text x="160" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">complete(...)</text>\n      <text x="160" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">ModelResponse</text>\n\n      <!-- OpenAICompatibleProvider -->\n      <rect x="280" y="272" width="180" height="116" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="370" y="296" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">OpenAICompatibleProvider</text>\n      <text x="370" y="316" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">base_url, api_key</text>\n      <text x="370" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">model, timeout</text>\n      <text x="370" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_client: HTTPXAsyncClient</text>\n\n      <!-- AnthropicProvider (stub) -->\n      <rect x="80" y="400" width="160" height="40" rx="6" fill="#ffffff" stroke="#bf