ght="12" rx="2" fill="#f5f5f5"/>\n      <text x="746" y="390" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">EXECUTE</text>\n\n      <rect x="918" y="400" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="942" y="410" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">VALIDATE</text>\n\n      <rect x="368" y="240" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="396" y="250" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">CHECK</text>\n\n      <rect x="308" y="160" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="332" y="170" fill="#2d3142" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">OWNS</text>\n\n      <rect x="308" y="80" width="40" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="328" y="90" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">LOAD</text>\n\n      <rect x="518" y="140" width="60" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="548" y="150" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">DISCOVER</text>\n\n      <rect x="568" y="300" width="80" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="608" y="310" fill="#2e5aa8" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">HTTP API</text>\n\n      <rect x="718" y="440" width="80" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="758" y="450" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">STDLIB</text>\n\n      <!-- Steps -->\n      <!-- CLI: Parse args, load config -->\n      <rect x="180" y="96" width="120" height="48" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="240" y="118" fill="#bf4520" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Parse args</text>\n      <text x="240" y="132" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle">sys.argv</text>\n\n      <rect x="340" y="96" width="120" height="48" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="400" y="118" fill="#bf4520" font-size="11" font-weight="600" font-family"\'Geist\', sans-serif" text-anchor="middle">Load config</text>\n      <text x="400" y="132" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle">from_env()</text>\n\n      <rect x="500" y="96" width="120" height="48" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="560" y="118" fill="#bf4520" font-size="11" font-weight="600" font-family"\'Geist\', sans-serif" text-anchor="middle">Initialize</text>\n      <text x="560" y="132" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle">components</text>\n\n      <rect x="660" y="96" width="120" height="48" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="720" y="118" fill="#bf4520" font-size="11" font-weight="600" font-family"\'Geist\', sans-serif" text-anchor="middle">Run loop</text>\n      <text x="720" y="132" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle">handle_input</text>\n\n      <!-- Agent Layer: AgentLoop orchestrates -->\n      <rect x="180" y="176" width="140" height="48" rx="6" fill="rgba(191,69,32,0.08)" stroke="#bf4520" stroke-width="1"/>\n      <text x="250" y="198" fill="#bf4520" font-size="11" font-weight="600" font-family"\'Geist\', sans-serif" text-anchor="middle">AgentLoop</text>\n      <text x="250" y="212" fill="#4f5d75" font-size="8" font-family"\'Geist Mono\', monospace" text-anchor="middle">orchestrates flow</text>\n\n      <rect x="360" y="176" 