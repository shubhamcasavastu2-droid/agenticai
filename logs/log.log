x="0 0 1000 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="arch-title arch-desc">\n      <title id="arch-title">AI Agent CLI · Layered architecture</title>\n      <desc id="arch-desc">Architecture diagram showing 6 layers: CLI (entry point), Agent Layer (AgentLoop, AgentState), Provider Layer (Provider interface, implementations), Tools Layer (ToolRegistry, 7 tools), Core Types (messages, blocks, schemas), and External Dependencies (httpx, stdlib).</desc>\n      <defs>\n        <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#4f5d75"/>\n        </marker>\n        <marker id="arrow-accent" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#bf4520"/>\n        </marker>\n        <marker id="arrow-link" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <polygon points="0 0, 8 3, 0 6" fill="#2e5aa8"/>\n        </marker>\n        <marker id="arrow-dashed" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">\n          <path d="M0,0 L8,3 L0,6" fill="none" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3"/>\n        </marker>\n      </defs>\n\n      <rect width="100%" height="100%" fill="#f5f5f5"/>\n      <rect width="100%" height="100%" fill="url(#dots)" opacity="0.55"/>\n      <defs>\n        <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse">\n          <circle cx="1" cy="1" r="0.9" fill="rgba(45,49,66,0.10)"/>\n        </pattern>\n      </defs>\n\n      <!-- ============================================================\n           ZONE DEFINITIONS (drawn first, behind everything)\n           ============================================================ -->\n      <!-- Zone: CLI Layer (full width) -->\n      <rect x="40" y="40" width="920" height="80" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="480" y="44" width="60" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="510" y="53" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">CLI</text>\n\n      <!-- Zone: Agent Layer (full width) -->\n      <rect x="40" y="140" width="920" height="100" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="468" y="144" width="84" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="510" y="153" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">AGENT LAYER</text>\n\n      <!-- Zone: Provider Layer (left half) -->\n      <rect x="40" y="260" width="440" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="230" y="264" width="96" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="278" y="273" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">PROVIDER</text>\n\n      <!-- Zone: Tools Layer (right half) -->\n      <rect x="500" y="260" width="460" height="140" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="700" y="264" width="72" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="736" y="273" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">TOOLS</text>\n\n      <!-- Zone: Core Types (left half) -->\n      <rect x="40" y="420" width="440" height="180" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="226" y="424" width="72" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="262" y="433" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">CORE TYPES</text>\n\n      <!-- Zone: External Dependencies (right half) -->\n      <rect x="500" y="420" width="460" height="180" rx="8"\n            fill="rgba(45,49,66,0.02)" stroke="rgba(45,49,66,0.10)" stroke-width="0.8"/>\n      <rect x="696" y="424" width="108" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="750" y="433" fill="rgba(45,49,66,0.40)" font-size="7" font-family="\'Geist Mono\', monospace"\n            text-anchor="middle" letter-spacing="0.14em">EXTERNAL DEPS</text>\n\n      <!-- ============================================================\n           NODES (drawn before arrows so arrows can reference centers)\n           ============================================================ -->\n      <!-- CLI (centered in CLI zone: 40-960, center=500) -->\n      <rect x="440" y="52" width="120" height="56" rx="6" fill="#ffffff" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="500" y="84" fill="#bf4520" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">CLI</text>\n      <text x="500" y="100" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">entry point</text>\n\n      <!-- Agent Layer: AgentLoop (focal) and AgentState side by side -->\n      <!-- AgentLoop centered at x=350 (left of center) -->\n      <rect x="280" y="152" width="140" height="76" rx="6" fill="rgba(191,69,32,0.04)" stroke="#bf4520" stroke-width="1.5"/>\n      <text x="350" y="176" fill="#bf4520" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AgentLoop</text>\n      <text x="350" y="196" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">orchestrator</text>\n      <text x="350" y="216" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">callbacks, state</text>\n\n      <!-- AgentState centered at x=650 (