right of center) -->\n      <rect x="580" y="152" width="140" height="76" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="650" y="176" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AgentState</text>\n      <text x="650" y="196" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">messages, steps</text>\n      <text x="650" y="216" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">tool calls, limits</text>\n\n      <!-- Provider Layer (zone: 40-480, center=260) -->\n      <!-- Provider (interface) - left side -->\n      <rect x="60" y="272" width="180" height="116" rx="6" fill="rgba(191,69,32,0.04)" stroke="#bf4520" stroke-width="1"/>\n      <rect x="60" y="272" width="180" height="32" rx="6" fill="rgba(191,69,32,0.10)"/>\n      <line x1="60" y1="304" x2="240" y2="304" stroke="rgba(191,69,32,0.40)" stroke-width="1"/>\n      <text x="150" y="292" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.08em">«interface»</text>\n      <text x="150" y="316" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">Provider</text>\n      <text x="150" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">complete(...)</text>\n      <text x="150" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">ModelResponse</text>\n\n      <!-- OpenAICompatibleProvider - right side -->\n      <rect x="260" y="272" width="200" height="116" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="360" y="296" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">OpenAICompatibleProvider</text>\n      <text x="360" y="316" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">base_url, api_key</text>\n      <text x="360" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">model, timeout</text>\n      <text x="360" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_client: HTTPXAsyncClient</text>\n\n      <!-- Stubs below -->\n      <rect x="60" y="400" width="180" height="40" rx="6" fill="#ffffff" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="150" y="424" fill="#bfc0c0" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AnthropicProvider</text>\n      <text x="150" y="440" fill="#bfc0c0" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«stub»</text>\n\n      <rect x="260" y="400" width="200" height="40" rx="6" fill="#ffffff" stroke="#bfc0c0" stroke-width="1" stroke-dasharray="4,3"/>\n      <text x="360" y="424" fill="#bfc0c0" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GeminiProvider</text>\n      <text x="360" y="440" fill="#bfc0c0" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">«stub»</text>\n\n      <!-- Tools Layer (zone: 500-960, center=730) -->\n      <!-- ToolRegistry - left side -->\n      <rect x="520" y="272" width="180" height="116" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="296" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">ToolRegistry</text>\n      <text x="610" y="316" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_tools: dict</text>\n      <text x="610" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">register, get, all</text>\n      <text x="610" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">schemas, execute</text>\n\n      <!-- PermissionGate - right side -->\n      <rect x="720" y="272" width="180" height="116" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="810" y="296" fill="#2d3142" font-size="11" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">PermissionGate</text>\n      <text x="810" y="316" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">_always_allow, _auto_allow</text>\n      <text x="810" y="336" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">check, allow, deny</text>\n      <text x="810" y="356" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">reset</text>\n\n      <!-- Concrete Tools (representative, 2 rows of 4) -->\n      <rect x="520" y="400" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="424" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">ReadFileTool</text>\n      <text x="610" y="440" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="720" y="400" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="810" y="424" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">WriteFileTool</text>\n      <text x="810" y="440" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="520" y="450" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="474" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">EditFileTool</text>\n      <text x="610" y="490" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">project_root, execute</text>\n\n      <rect x="720" y="450" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="810" y="474" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">BashTool</text>\n      <text x="810" y="490" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">command, timeout</text>\n\n      <rect x="520" y="500" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="524" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GlobTool</text>\n      <text x="610" y="540" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">pattern, execute</text>\n\n      <rect x="720" y="500" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="810" y="524" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">GrepTool</text>\n      <text x="810" y="540" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">pattern, path, include</text>\n\n      <rect x="520" y="550" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="610" y="574" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">AskUserTool</text>\n      <text x="610" y="590" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle">ask_callback, execute</text>\n\n      <rect x="720" y="550" width="180" height="40" rx="6" fill="#ffffff" stroke="#2d3142" stroke-width="1"/>\n      <text x="810" y="574" fill="#2d3142" font-size="10" font-weight="600" font-family="\'Geist\', sans-serif" text-anchor="middle">PlanTool</text>\n      <text x="810" y=