"440" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="580" y="420" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="608" y="430" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">execute</text>\n\n      <!-- 10. ToolRegistry --> AgentLoop: ToolResult -->\n      <line x1="820" y1="480" x2="460" y2="480" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow-return)"/>\n      <rect x="580" y="460" width="64" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="612" y="470" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">ToolResult</text>\n\n      <!-- 11. AgentLoop -> Provider: complete (with tool results) -->\n      <line x1="460" y1="520" x2="640" y2="520" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="520" y="500" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="548" y="510" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">complete</text>\n\n      <!-- 12. Provider --> AgentLoop: ModelResponse (final) -->\n      <line x1="640" y1="580" x2="460" y2="580" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-filled-accent)"/>\n      <rect x="520" y="560" width="80" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="560" y="570" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">ModelResponse</text>\n\n      <!-- 13. AgentLoop --> CLI: response -->\n      <line x1="460" y1="620" x2="280" y2="620" stroke="#bf4520" stroke-width="1.4" marker-end="url(#arrow-filled-accent)"/>\n      <rect x="340" y="600" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="368" y="610" fill="#bf4520" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.0