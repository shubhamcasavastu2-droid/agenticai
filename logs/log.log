nt-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">validate</text>\n\n      <!-- 6. validate_path --> Concrete Tool: validated/PathValidationError -->\n      <line x1="760" y1="380" x2="600" y2="380" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow-return)"/>\n      <rect x="660" y="360" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="684" y="370" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">validated</text>\n\n      <!-- 7. Concrete Tool -> check_deny_list: command (BashTool only) -->\n      <line x1="600" y1="420" x2="920" y2="420" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="730" y="400" width="56" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="758" y="410" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">check</text>\n\n      <!-- 8. check_deny_list --> Concrete Tool: allowed/denied -->\n      <line x1="920" y1="440" x2="600" y2="440" stroke="#4f5d75" stroke-width="1" stroke-dasharray="4,3" marker-end="url(#arrow-return)"/>\n      <rect x="730" y="420" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="754" y="430" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">allowed</text>\n\n      <!-- 9. Concrete Tool executes (self-message) -->\n      <path d="M 600,480 H 640 Q 648,480 648,488 V 520 Q 648,528 640,528 H 600"\n            fill="none" stroke="#4f5d75" stroke-width="1.2" marker-end="url(#arrow-filled)"/>\n      <rect x="610" y="480" width="48" height="12" rx="2" fill="#f5f5f5"/>\n      <text x="634" y="490" fill="#4f5d75" font-size="8" font-family="\'Geist Mono\', monospace" text-anchor="middle" letter-spacing="0.06em">execute</text>\n\n      <!-- 10. Concrete Tool --> ToolRegistry: ToolResult -->\n      <line x1="6