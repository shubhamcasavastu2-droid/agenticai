# Agentic CLI Configuration
# Copy to .env and customize

# NVIDIA NIM (OpenAI-compatible)
AGENTIC_BASE_URL=https://integrate.api.nvidia.com/v1
AGENTIC_API_KEY=replace_with_a_new_nvidia_api_key
AGENTIC_MODEL=z-ai/glm-5.3-flash
AGENTIC_REQUEST_TIMEOUT_SECONDS=300
# Maximum tokens generated per model response
AGENTIC_MAX_COMPLETION_TOKENS=1000000
# Model context limit used to compare provider-reported input/output token usage
AGENTIC_CONTEXT_WINDOW_TOKENS=232768

# Optional: Project root (defaults to current directory)
# AGENTIC_PROJECT_ROOT=.

# Optional: Max output size for tool results (default: 8000)
AGENTIC_MAX_OUTPUT_SIZE=500000

# Optional: Max agent steps per task (default: 50)
# AGENTIC_MAX_STEPS=50

# Optional: Agent completion-review attempts (default: 3)
# AGENTIC_MAX_COMPLETION_ATTEMPTS=3